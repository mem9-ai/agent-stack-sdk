{
  "name": "@tidblink/server",
  "version": "0.3.0-rc.0",
  "description": "Official TypeScript SDK for TiDB Link",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "tidbLinkApiVersion": "0.0.1",
  "tidbLinkRevision": "1c7f98ee12c28e3d1adb656b90324c0b95135e42",
  "tidbLinkOpenApiSha256": "c4cd8062d92750b2b354cb6f817211c9e3128155bf3a2a95cb5a36bae9dd71d6",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./examples/prepare-realtime-connection.mjs": "./examples/prepare-realtime-connection.mjs",
    "./examples/create-session.mjs": "./examples/create-session.mjs",
    "./examples/send-message.mjs": "./examples/send-message.mjs",
    "./examples/control-turn.mjs": "./examples/control-turn.mjs",
    "./examples/observe-message.mjs": "./examples/observe-message.mjs",
    "./examples/read-usage.mjs": "./examples/read-usage.mjs",
    "./examples/upload-file.mjs": "./examples/upload-file.mjs",
    "./examples/answer-client-tool.mjs": "./examples/answer-client-tool.mjs",
    "./examples/submit-audio.mjs": "./examples/submit-audio.mjs",
    "./examples/device-voice-session.mjs": "./examples/device-voice-session.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "examples/prepare-realtime-connection.mjs",
    "examples/create-session.mjs",
    "examples/send-message.mjs",
    "examples/control-turn.mjs",
    "examples/observe-message.mjs",
    "examples/read-usage.mjs",
    "examples/upload-file.mjs",
    "examples/answer-client-tool.mjs",
    "examples/submit-audio.mjs",
    "examples/device-voice-session.mjs"
  ],
  "scripts": {
    "build": "node --eval \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "npm run build",
    "test": "npm run build && node --test 'test/**/*.test.mjs'",
    "test:service-contract": "node --test 'service-contract/**/*.test.mjs'",
    "pack:check": "npm pack --dry-run",
    "test:service": "npm run build && node test/service/run.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mem9-ai/tidblink-sdk.git",
    "directory": "typescript"
  },
  "bugs": {
    "url": "https://github.com/mem9-ai/tidblink-sdk/issues"
  },
  "homepage": "https://github.com/mem9-ai/tidblink-sdk#readme"
}
