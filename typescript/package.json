{
  "name": "@mem9/agent-stack",
  "version": "0.2.0",
  "description": "Official TypeScript SDK for Agent Stack",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "agentServiceApiVersion": "0.0.1",
  "agentServiceRevision": "95475ff6a9a7a1a98f8b3efbf57b89fb263e7025",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node --eval \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "npm run build && tsc --noEmit --strict --module NodeNext --moduleResolution NodeNext --target ES2023 --lib ES2023,DOM,DOM.Iterable examples/quickstart.ts",
    "test": "npm run build && node --test 'test/**/*.test.mjs'",
    "test:service-contract": "node --test 'service-contract/**/*.test.mjs'",
    "pack:check": "npm pack --dry-run"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mem9-ai/agent-stack-sdk.git",
    "directory": "typescript"
  },
  "bugs": {
    "url": "https://github.com/mem9-ai/agent-stack-sdk/issues"
  },
  "homepage": "https://github.com/mem9-ai/agent-stack-sdk#readme"
}
