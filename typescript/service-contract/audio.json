{
  "revision": "0d11f1b231879c735bd53b60ff895ac58ba60d33",
  "sourceOpenApiSha256": "ce6ac6c2b1e2e50461455a85eb4aedffd8958019d15ef95e6b8254eaef54a9dc",
  "paths": {
    "/api/v1/user/sessions/{id}/turns/audio": {
      "post": {
        "operationId": "SessionsController_createAudioTurn",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Audio file to transcribe. Supported formats: mp3, mp4, mpeg, mpga, m4a, wav, webm."
                  },
                  "billingTag": {
                    "nullable": true,
                    "description": "Omit to inherit the Session default, send one JSON Billing Tag object to override it, or send the JSON literal null to clear it for this Turn.",
                    "allOf": [
                      {
                        "$ref": "#/components/schemas/BillingTag"
                      }
                    ]
                  }
                }
              },
              "encoding": {
                "billingTag": {
                  "contentType": "application/json"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Audio Turn outside ordinary JSON text input identity/recovery guarantees. The owning response uses SSE frames whose event name and JSON data identify the TurnStreamEvent, with comment keepalives; turn_started may omit inputId. Closing its active upstream requests interruption. Cancel an owned live Turn through POST events with a stable clientEventId and its exact turnId.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "Each SSE frame contains event: <TurnStreamEvent.event> and data: <TurnStreamEvent JSON>, terminated by a blank line. Comment frames are keepalive heartbeats.",
                  "x-sse-event-schema": {
                    "$ref": "#/components/schemas/TurnStreamEvent"
                  }
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-cache, no-transform"
                  ]
                }
              },
              "X-Accel-Buffering": {
                "required": true,
                "schema": {
                  "type": "string",
                  "enum": [
                    "no"
                  ]
                }
              }
            }
          },
          "409": {
            "description": "The Session is read-only (session_read_only), or already has an active Turn (session_has_active_turn), either before transcription or reservation, or because another Turn starts during transcription. Conflicts after accepted transcription retain ASR usage.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "The platform-funded LLM spend limit is exhausted before streaming starts.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "error": {
                    "code": "llm_spend_limit_exhausted",
                    "message": "LLM spend limit exhausted"
                  }
                }
              }
            }
          },
          "501": {
            "description": "Audio transcription is disabled because ASR_OPENAI_API_KEY is not configured.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "New Turn admission is temporarily closed for deployment maintenance or recovery (turn_admission_closed), or the deployment lacks the Sandbox or Drive9 service a new Turn needs (service_configuration_unavailable; details.reason names it). Normally this refusal happens before the audio is read, transcribed or billed and before anything is saved. If the configuration changes concurrently, the same 503 can follow transcription; that transcription remains billed and no Turn is saved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "error": {
                    "code": "turn_admission_closed",
                    "message": "New Turns are temporarily unavailable"
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "UserApiKey": []
          }
        ],
        "tags": [
          "Sessions"
        ],
        "description": "Authorization: UserApiKey; persisted credentials determine Organization and End User scope."
      }
    }
  },
