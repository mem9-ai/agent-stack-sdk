        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
            "description": "Case-sensitive key: a lowercase ASCII letter followed by up to 63 lowercase ASCII letters, digits, underscores, dots, or hyphens."
          },
          "value": {
            "type": "string",
            "description": "Case-sensitive value normalized to NFC and limited to 1–128 bytes in UTF-8. Leading or trailing Unicode whitespace and Unicode control or format characters are rejected."
