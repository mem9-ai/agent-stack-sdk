      "TurnFailure": {
        "type": "object",
        "description": "A failed Turn's public error, as carried by its turn_error event and Turn.failure. The message is fixed text for the code and never contains supplier or internal error text.",
        "required": [
          "code",
          "message"
        ],
        "properties": {
